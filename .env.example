# GitHub Repository Secrets / local ingestion environment only:
GEMINI_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase service-role JWT or server secret key; NEVER expose to browser.
SUPABASE_KEY=

# Browser settings: Supabase anon JWT or publishable key ONLY.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local ingestion settings; Actions uses a repository variable for daily limit.
GEMINI_DAILY_REQUEST_LIMIT=15
MAX_ARTICLES_PER_RUN=3
